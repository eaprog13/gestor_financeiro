// Schema da aplicação de Gestão Financeira
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Uma categoria de despesa (ex: Supermercado, Farmácia, Gasolina...)
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String // nome do ícone (lucide-react)
  color     String // cor em hex, usada em fundos/gráficos
  isDefault Boolean  @default(false) // categorias base, não podem ser apagadas
  order     Int      @default(0)
  createdAt DateTime @default(now())

  expenses Expense[]

  @@map("categories")
}

// Uma despesa individual
model Expense {
  id         String   @id @default(cuid())
  amount     Float
  note       String?
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([date])
  @@index([categoryId])
  @@map("expenses")
}
